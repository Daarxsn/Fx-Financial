# Safe placeholders only. Put real credentials in the ignored .env.local file.
DATABASE_HOST=your-mysql-host
DATABASE_PORT=3306
DATABASE_NAME=defaultdb
DATABASE_USER=your-database-user
DATABASE_PASSWORD=replace-locally
DATABASE_SSL=true
# Optional: provide Aiven's PEM CA when it is not in the Node.js system trust store.
# Set at most one. Keep a local PEM file path in .env.local; in deployments use a secret env value.
# DATABASE_SSL_CA_PATH=/absolute/path/to/ca.pem
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE----- ..."

# Generate a unique random value of at least 32 characters per environment.
# This placeholder is not a usable production secret.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Private PDF storage. Local development/tests use the filesystem; set DOCUMENTS_STORAGE_DRIVER=s3 in production/Vercel.
# Production/Vercel rejects filesystem storage and requires a configured private S3-compatible bucket.
DOCUMENTS_STORAGE_DRIVER=filesystem
DOCUMENTS_STORAGE_BUCKET=your-private-document-bucket
DOCUMENTS_STORAGE_REGION=ap-south-1
DOCUMENTS_STORAGE_ACCESS_KEY_ID=replace-locally
DOCUMENTS_STORAGE_SECRET_ACCESS_KEY=replace-locally
# Optional S3-compatible provider endpoint. Leave unset for standard AWS S3.
# DOCUMENTS_STORAGE_ENDPOINT=https://your-s3-compatible-endpoint
# DOCUMENTS_STORAGE_FORCE_PATH_STYLE=true
# DOCUMENTS_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# For KMS-managed encryption, use aws:kms plus a provider-approved key ARN/ID.
# DOCUMENTS_STORAGE_SERVER_SIDE_ENCRYPTION=aws:kms
# DOCUMENTS_STORAGE_KMS_KEY_ID=replace-with-approved-key-id
# Local development/testing only; this directory is ephemeral and is never suitable as production retention.
# DOCUMENTS_STORAGE_LOCAL_ROOT=/tmp/fx-financial-private-documents
